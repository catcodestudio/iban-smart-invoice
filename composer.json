{
    "name": "catcode/iban-smart-invoice",
    "description": "WooCommerce QR + deep-link IBAN invoice with Monobank webhook detection",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0",
        "chillerlan/php-qrcode": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CatCode\\IbanSmartInvoice\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CatCode\\IbanSmartInvoice\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
